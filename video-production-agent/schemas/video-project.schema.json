{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/daily-3d-science-video/video-project.schema.json",
  "title": "Video Project",
  "type": "object",
  "required": ["schema_version", "project_id", "title", "target", "shots", "approvals", "output"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"},
    "title": {"type": "string", "minLength": 1},
    "language": {"type": "string"},
    "target": {
      "type": "object",
      "required": ["aspect_ratio", "width", "height", "fps"],
      "properties": {
        "platform": {"type": "string"},
        "aspect_ratio": {"type": "string", "enum": ["16:9", "9:16", "1:1", "4:3"]},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "expected_duration_seconds": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": true
    },
    "visual_bible": {"type": "object"},
    "fact_checks": {"type": "array"},
    "shots": {
      "type": "array",
      "items": {"$ref": "shot-task.schema.json"}
    },
    "audio": {"type": "object"},
    "approvals": {"type": "object"},
    "output": {"type": "object"}
  },
  "additionalProperties": true
}
